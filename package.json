    "db:seed:demo": "tsx --conditions=react-server prisma/seed/demo.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
